<Window x:Class="lab0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab0"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
            Margin="10">

            <!-- Случайные фигуры -->
            <StackPanel Orientation="Horizontal"
                Margin="0,0,0,5">

                <Button Content="Произвольный треугольник"
                Click="TriangleButton_Click"
                Margin="5"
                Padding="10,5"/>

                <Button Content="Произвольный прямоугольник"
                Click="RectangleButton_Click"
                Margin="5"
                Padding="10,5"/>

                <Button Content="Квадрат"
                Click="SquareButton_Click"
                Margin="5"
                Padding="10,5"/>

            </StackPanel>

            <!-- Заданные пользователем значения -->
            <StackPanel Orientation="Horizontal"
                Margin="0,0,0,5">

                <TextBlock Text="X:"
                   VerticalAlignment="Center"
                   Margin="5"/>

                <TextBox x:Name="XInput"
                 Width="60"
                 Text="100"
                 Margin="5"/>

                <TextBlock Text="Y:"
                   VerticalAlignment="Center"
                   Margin="5"/>

                <TextBox x:Name="YInput"
                 Width="60"
                 Text="100"
                 Margin="5"/>

                <TextBlock Text="Размер:"
                   VerticalAlignment="Center"
                   Margin="5"/>

                <TextBox x:Name="SizeInput"
                 Width="60"
                 Text="150"
                 Margin="5"/>

                <Button Content="Треугольник"
                Click="CustomTriangleButton_Click"
                Margin="5"
                Padding="10,5"/>

                <Button Content="Квадрат"
                Click="CustomSquareButton_Click"
                Margin="5"
                Padding="10,5"/>

            </StackPanel>

            <!-- Перемещение -->
            <StackPanel Orientation="Horizontal"
                Margin="0,0,0,5">

                <TextBlock Text="Сдвиг X:"
                   VerticalAlignment="Center"
                   Margin="5"/>

                <Slider x:Name="MoveXSlider"
                Minimum="-300"
                Maximum="300"
                Value="0"
                Width="200"
                Margin="5"
                ValueChanged="MoveSlider_ValueChanged"/>

                <TextBlock Text="Сдвиг Y:"
                   VerticalAlignment="Center"
                   Margin="5"/>

                <Slider x:Name="MoveYSlider"
                Minimum="-300"
                Maximum="300"
                Value="0"
                Width="200"
                Margin="5"
                ValueChanged="MoveSlider_ValueChanged"/>

            </StackPanel>

        </StackPanel>

        <Canvas x:Name="Scene"
                Grid.Row="1"
                Background="White"
                Margin="10"/>
    </Grid>
</Window>
