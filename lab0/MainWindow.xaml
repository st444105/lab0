<Window x:Class="lab0.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab0"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Margin="10">

            <Button Content="Произвольный треугольник"
                    Click="TriangleButton_Click"
                    Margin="5"
                    Padding="10,5"/>

            <Button Content="Произвольный прямоугольник"
                    Click="RectangleButton_Click"
                    Margin="5"
                    Padding="10,5"/>

            <Button Content="Квадрат"
                    Click="SquareButton_Click"
                    Margin="5"
                    Padding="10,5"/>
        </StackPanel>

        <Canvas x:Name="Scene"
                Grid.Row="1"
                Background="White"
                Margin="10"/>
    </Grid>
</Window>
